{% extends 'layouts/base.html.twig' %}

{% block page_title %}
    {% if selectedYear == 'anciens' %}
        Historique des meetups - AFUP {{ tenant.antenne.label }}
    {% else %}
        Meetups {{ selectedYear }} - AFUP {{ tenant.antenne.label }}
    {% endif %}
{% endblock %}

{% block page_description %}
    {% if selectedYear == 'anciens' %}
        Historique de tous les meetups AFUP {{ tenant.antenne.label }}.
    {% else %}
        Retrouvez les meetups AFUP {{ tenant.antenne.label }} de {{ selectedYear }}.
    {% endif %}
{% endblock %}

{% block jsonld %}
    {{ jsonld.events(selectedMeetups).toScript()|raw }}
{% endblock %}

{% block body %}

    <div class="sm:mx-auto sm:max-w-5xl sm:flex flex-col p-4 sm:p-0">

        <nav class="text-white mb-5 text-2xl border-b w-full flex items-start overflow-x-auto md:overflow-hidden">
            <ul class="flex flex-nowrap items-end text-heading gap-4 md:gap-8">
                {% for year in years %}
                    <li class="{% if selectedYear != year or selectedYear == 'anciens' %}hover:border-b-2{% endif %}">
                        <a href="{{ path('meetups', { subdomain: tenant.subdomain, year: year }) }}"
                           class="{% if selectedYear == year %}font-black text-3xl md:text-4xl{% endif %}">{{ year|capitalize }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <main class="flex flex-col gap-5 mb-5 md:mb-0">
            {% for meetup in selectedMeetups %}
                {% set isUpcoming = meetup.date > date() %}
                <article class="group relative flex flex-col bg-white p-5 rounded shadow-xl gap-5 cursor-pointer transition-transform hover:-translate-y-0.5">
                    <a href="{{ meetup.url }}" class="absolute inset-0" aria-label="{{ meetup.title }}"></a>
                    <input type="checkbox" id="desc-{{ loop.index }}" class="hidden peer">
                    <div class="flex flex-col md:flex-row gap-5">
                        {% if meetup.photo %}
                            <img class="w-full rounded md:object-cover md:h-40 md:w-3xs shrink-0" src="{{ meetup.photo }}" alt="{{ meetup.title }}">
                        {% endif %}
                        <header class="flex flex-col flex-1">
                            {% if isUpcoming %}
                                <span class="pointer-events-none self-start mb-2 rounded bg-ruby-500 px-2 py-0.5 text-sm font-bold text-white md:absolute md:top-0 md:right-0 md:mb-0 md:rounded-none md:rounded-tr md:rounded-bl md:px-4 md:py-2 md:text-base md:shadow" data-qa="upcoming-meetup">À venir</span>
                            {% endif %}
                            <h5 class="text-2xl font-bold tracking-tight {% if isUpcoming %}md:pr-24{% endif %}">{{ meetup.title }}</h5>
                            <small>
                                {{ meetup.date|format_datetime(pattern: 'EEEE d LLLL à H:mm', locale: 'fr') }}
                                {% if selectedYear == 'anciens' %}
                                    {{ meetup.date.format('Y') }}
                                {% endif %}
                            </small>
                            <div class="mt-auto pt-6 md:pt-2 flex items-center gap-4">
                                {% if isUpcoming %}
                                    <a href="{{ meetup.url }}"
                                       class="relative z-10 shrink-0 rounded-xl bg-ruby-500 px-4 py-2 font-semibold text-white shadow transition hover:bg-ruby-700"
                                       data-qa="meetup-register">Je m'inscris</a>
                                {% endif %}
                                <label for="desc-{{ loop.index }}"
                                       class="relative z-10 cursor-pointer inline-flex items-center gap-1 ml-auto whitespace-nowrap underline">
                                    {# Sur mobile, texte court : le chevron indique l'état ouvert/fermé #}
                                    <span class="sm:hidden">Description</span>
                                    <span class="hidden sm:inline sm:group-has-[:checked]:hidden">Voir la description</span>
                                    <span class="hidden sm:group-has-[:checked]:inline">Masquer la description</span>
                                    <twig:ux:icon name="mdi:chevron-down" class="size-5 group-has-[:checked]:hidden" aria-hidden="true" />
                                    <twig:ux:icon name="mdi:chevron-up" class="size-5 hidden group-has-[:checked]:block" aria-hidden="true" />
                                </label>
                            </div>
                        </header>
                    </div>

                    <div class="hidden peer-checked:block">
                        {{ meetup.description|nl2br|markdown_to_html }}
                    </div>
                </article>
            {% endfor %}
        </main>

    </div>

{% endblock %}
