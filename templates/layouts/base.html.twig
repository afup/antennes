{% extends 'layouts/root.html.twig' %}

{% block head %}

    {% set page_title %}{% block page_title %}AFUP {{ tenant.antenne.label }}{% endblock %}{% endset %}
    {% set page_description %}{% block page_description %}Site de l'antenne AFUP {{ tenant.antenne.label }}.{% endblock %}{% endset %}

    {% if app.request.attributes.get('_route') %}
        {% set canonical_url = url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) %}
    {% else %}
        {% set canonical_url = app.request.schemeAndHttpHost %}
    {% endif %}

    <title>{{ page_title|trim }}</title>
    <meta name="description" content="{{ page_description|trim }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {% block favicon %}
        <link rel="icon" href="{{ tenant.antenne.logo.simple }}" sizes="any" type="image/svg+xml">
    {% endblock %}

    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title|trim }}">
    <meta property="og:description" content="{{ page_description|trim }}">
    <meta property="og:site_name" content="AFUP {{ tenant.antenne.label }}">
    {% block og_image %}
        <meta property="og:image" content="{{ absolute_url(asset('logos/afup-antenne-' ~ tenant.antenne.code ~ '.svg')) }}">
    {% endblock %}

    {% block jsonld %}
        {{ jsonld.organisation().toScript() | raw }}
    {% endblock %}

{% endblock %}

{% block main %}

    <div class="px-5 pt-10 md:pt-20 pb-5 md:pb-10">
        <div class="mx-auto sm:max-w-3xl">
            <a href="{{ path('home', { subdomain: tenant.subdomain }) }}">
                <img src="{{ asset('logos/afup-antenne-' ~ tenant.antenne.code ~ '.svg') }}"
                     class="drop-shadow-lg"
                     alt="Logo de l'antenne AFUP {{ tenant.antenne.label }}"/>
            </a>
        </div>
    </div>

    <div class="text-white text-center p-4 sm:p-0 pb-4 sm:pb-10 text-xl sm:text-2xl md:block flex justify-around items-center gap-3">
        <a href="https://afup.org" class="hover:underline">afup.org</a>
        <span class="md:px-3">
                        <twig:ux:icon name="separator" class="h-5 inline-block" />
                    </span>
        <a href="https://afup.org/association/devenir-membre" class="hover:underline">Adhérer</a>
        <span class="md:px-3">
                        <twig:ux:icon name="separator" class="h-5 inline-block" />
                    </span>
        <a href="{{ path('meetups', { subdomain: tenant.subdomain }) }}" class="hover:underline">Meetups</a>
    </div>

    {% block body %}{% endblock %}

{% endblock %}
